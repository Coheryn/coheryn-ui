{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CoherynUIRecipeEntry",
  "type": "object",
  "required": [
    "id",
    "name",
    "category",
    "description",
    "css_declarations",
    "variants"
  ],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "category": { "type": "string" },
    "description": { "type": "string" },
    "css_declarations": { "type": "string" },
    "variants": {
      "type": "array",
      "items": { "type": "string" }
    },
    "fallback": { "type": ["string", "null"] }
  }
}
