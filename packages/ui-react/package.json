{
  "name": "@coherynui/react",
  "version": "1.0.1",
  "description": "Accessible React component facade styled with CoherynUI CSS Engine recipes and tokens",
  "homepage": "https://coheryntech.com/products/coheryn-ui",
  "repository": {
    "type": "git",
    "url": "https://github.com/Coheryn/coheryn-ui.git",
    "directory": "packages/ui-react"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@coherynui/components": "workspace:^",
    "@coherynui/motion": "workspace:^",
    "@coherynui/tokens": "workspace:^"
  },
  "scripts": {
    "build": "tsc"
  },
  "license": "MIT OR Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ]
}
