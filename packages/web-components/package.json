{
  "name": "@coheryn/coherynui-web-components",
  "version": "1.1.0",
  "description": "Native Web Component Custom Elements for CoherynUI \u2014 Zero-framework accessible UI primitives",
  "homepage": "https://coheryntech.com/products/coheryn-ui",
  "repository": {
    "type": "git",
    "url": "https://github.com/Coheryn/coheryn-ui.git",
    "directory": "packages/web-components"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "dependencies": {
    "@coheryn/coherynui-components": "workspace:^"
  },
  "scripts": {
    "build": "tsc"
  },
  "license": "MIT OR Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ]
}
